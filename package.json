{
  "name": "map-dyoa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:introspect": "drizzle-kit introspect",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:ensure-schedule-updated-at": "bun run scripts/run-sql.ts scripts/add-schedule-updated-at.sql",
    "db:ensure-bongnudo-profile": "bun run scripts/run-sql.ts scripts/add-bongnudo-profile.sql",
    "db:ensure-clip-candidate": "bun run scripts/run-sql.ts scripts/add-clip-candidate.sql",
    "db:ensure-clip-week-play": "bun run scripts/run-sql.ts scripts/add-clip-week-play.sql",
    "db:ensure-clip-recommend": "bun run scripts/run-sql.ts scripts/add-clip-recommend.sql",
    "db:ensure-feedback-reply": "bun run scripts/run-sql.ts scripts/add-feedback-reply.sql",
    "db:ensure-schedule-start-time-index": "bun run scripts/run-sql.ts scripts/add-schedule-start-time-index.sql",
    "db:studio": "drizzle-kit studio",
    "sentry:verify": "bun run scripts/sentry-verify.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/bun": "10.76.2",
    "@sentry/elysia": "^10.76.2",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "brace-expansion": "2.1.7"
  }
}
